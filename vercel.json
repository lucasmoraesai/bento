{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "cd slides && npm ci --no-audit --no-fund",
  "buildCommand": "cd slides && npx tsc -b && SINGLEFILE=1 npx vite build --outDir dist-single",
  "outputDirectory": "slides/dist-single",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
